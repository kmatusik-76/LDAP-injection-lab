dn: ou=assets,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: assets

# --- Zasoby publiczne (maja cn i ou, wiec widac je zwyklym wyszukiwaniem) ---
dn: cn=drukarka-hr,ou=assets,dc=example,dc=com
objectClass: top
objectClass: device
cn: drukarka-hr
ou: assets
description: Drukarka sieciowa w dziale HR
serialNumber: PRN-2201

dn: cn=serwer-vpn,ou=assets,dc=example,dc=com
