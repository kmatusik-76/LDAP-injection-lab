objectClass: device
cn: serwer-vpn
ou: assets
description: Brama VPN dla pracownikow zdalnych
serialNumber: VPN-0042

# --- Zasob ukryty: cel Zadania 3 (brak cn i ou, trzeba wstrzyknac warunek) ---
dn: serialNumber=KEY-7731,ou=assets,dc=example,dc=com
objectClass: top
objectClass: device
serialNumber: KEY-7731
description: FLAG{ldap_or_attribute_injection}

dn: ou=sandbox,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: sandbox

