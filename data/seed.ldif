# Dane katalogu dla laboratorium LDAP injection.
#
# To jest celowo podatne srodowisko dydaktyczne. Rekordy sa podzielone na
# poddrzewa, zeby kazde zadanie mialo swoj zasieg:
#
#   dc=example,dc=com                root organizacji
#     uid=admin,...                  konto administratora (Zadanie 1)
#     cn=svc-webapp,...              konto serwisowe aplikacji
#     ou=people,...                  pracownicy (Zadanie 2 i 4)
#     ou=assets,...                  zasoby/urzadzenia (Zadanie 3)
#     ou=sandbox,...                 piaskownica konsoli (bez flag)
#
# Flagi maja format FLAG{...} i sa poukrywane w atrybutach rekordow, do
# ktorych zwykly uzytkownik nie powinien miec dostepu.

dn: dc=example,dc=com
objectClass: top
objectClass: dcObject
objectClass: organization
dc: example
o: Example Sp. z o.o.

# --- Administrator: cel Zadania 1 (ominiecie logowania) ---
dn: uid=admin,dc=example,dc=com
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: admin
cn: Administrator Systemu
sn: Systemu
mail: admin@example.com
title: Administrator
departmentNumber: IT
employeeType: restricted
description: FLAG{ldap_login_bypass_wildcard}
userPassword: 7Qx9-Lm2v-Rt4k-NieDoZgadniecia

# --- Konto serwisowe aplikacji (uzywane wewnetrznie do wyszukiwania) ---
dn: cn=svc-webapp,dc=example,dc=com
objectClass: top
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: svc-webapp
description: Konto serwisowe aplikacji, tylko do wyszukiwania
userPassword: svc-webapp-lab-only

dn: ou=people,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: people

# --- Pracownicy publiczni (widoczni w ksiazce adresowej) ---
