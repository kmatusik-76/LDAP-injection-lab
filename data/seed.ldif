objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: jkowalski
cn: Jan Kowalski
sn: Kowalski
mail: jkowalski@example.com
title: Programista
departmentNumber: IT
employeeType: public
telephoneNumber: +48 500 000 101
userPassword: Kowalski-Lab-101

